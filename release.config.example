# release.config.example
#
# Copy this file to "release.config" (same directory as release.sh) to
# override any of the fixed defaults baked into release.sh. This file is
# entirely optional — release.sh works with no release.config at all.
#
# release.config is parsed as plain KEY=VALUE lines (no shell execution,
# no quoting rules beyond leading/trailing whitespace trimming). Lines
# starting with # are comments. Any key not recognized by release.sh
# causes it to refuse to start.
#
# This file must never contain secrets. It only ever holds the same kind
# of infrastructure metadata that already appears, in plain text, at the
# top of release.sh (hostnames, container names, paths). Tokens,
# encryption keys, and passwords belong only in the VPS-side auth file
# referenced by AUTH_FILE below — never here, and never committed.

LOCAL_PROJECT_DIR=/Users/kevinpoulos/Documents/Projects/DeploymentPlatform
VPS_HOST=94.130.73.188
VPS_USER=kevin
SSH_KEY=/Users/kevinpoulos/.ssh/hetzner_deployment
VPS_SOURCE_DIR=/opt/deployment-platform/source
AUTH_FILE=/opt/deployment-platform/config/auth.env
# The non-secret companion to AUTH_FILE — read fresh on every API
# container replacement, same as AUTH_FILE.
PLATFORM_ENV_FILE=/opt/deployment-platform/config/platform.env
CADDY_ROUTES_DIR=/opt/deployment-platform/caddy/routes
API_CONTAINER=deployment-platform-api
WEB_CONTAINER=deployment-platform-web
API_IMAGE_REPOSITORY=deployment-platform-api
WEB_IMAGE_REPOSITORY=deployment-platform-web
PLATFORM_NETWORK=deployment-platform
MANAGED_APPS_NETWORK=deployment-apps
API_DATA_VOLUME=deployment-platform-api-data

# The Caddy container, and the guided installer's install root. Both are
# only used by config-only releases: a Caddyfile change is re-rendered
# and applied in place, and an installer/ change refreshes the installed
# copy at ${INSTALL_ROOT}/installer plus /usr/local/bin/deployment-platform.
# The live Caddyfile is assumed to sit next to CADDY_ROUTES_DIR.
CADDY_CONTAINER=deployment-platform-caddy
INSTALL_ROOT=/opt/deployment-platform
# ---------------------------------------------------------------------
# Public URL verification
# ---------------------------------------------------------------------
#
# PUBLIC_URL_PANEL is MANDATORY. It is the platform's own dashboard, it
# exists on every installation, and a release that cannot serve it is not
# a successful release. It must return HTTP 200.
PUBLIC_URL_PANEL=https://panel.hookstats.com

# The two app smoke-test URLs are OPTIONAL and default to disabled.
#
# They point at deployed test apps, which do NOT exist on a freshly
# installed server — the Caddy routes directory is empty until an app is
# created — so requiring them made the first release after an install
# impossible.
#
#   left empty / omitted -> the check is reported as SKIPPED, with the
#                           reason stated in the release summary
#   set to a URL         -> the check is MANDATORY and must return
#                           HTTP 200; a connection failure (HTTP 000)
#                           fails the release and is never treated as a
#                           skip
#
# Enable these once the corresponding test apps have actually been
# deployed. Do NOT point them at the panel URL to "make them pass": that
# would claim test-app coverage that never happened.
PUBLIC_URL_WIZARD_TEST=
PUBLIC_URL_SQLITE_TEST=
