node_modules
dist
*.tsbuildinfo
.env
.env.*
!.env.example
*.log
.DS_Store
coverage
data

# Release-signing PRIVATE keys must never be committed. Public keys
# (installer/trusted-keys/*.pem) are intentionally tracked; a private key
# would end in one of these patterns — belt and braces so one never slips in.
*.private.pem
*-private.pem
release-signing-*.key

generate-auth.sh

# Operator-local release target configuration (host, user, SSH key path,
# public URLs). Not secret by policy — see release.config.example — but it
# describes one specific server and must not be committed. Copy
# release.config.example instead.
release.config

# Local dev-tool config (preview server launch configs) and dropped-in
# source art for branding work — not part of the deployed app.
.claude/
assets/

# Throwaway bootstrap clones (run the bootstrap from OUTSIDE the repo, e.g. /opt)
cf-bootstrap/
