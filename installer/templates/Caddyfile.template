# Generated by installer/lib/caddy.sh — do not hand-edit; changes will
# be overwritten on the next install/resume run. Per-app routes are
# never defined here — they live in ./routes/*.caddy, written by the
# platform API itself when an app's domain is assigned.

{
	# Caddy's own admin API stays bound to localhost inside the container
	# only — it is never exposed on a public listener.
	admin off
}

__PANEL_DOMAIN__ {
	encode gzip

	handle /api/* {
		reverse_proxy __API_CONTAINER__:__API_PORT__
	}

	handle {
		reverse_proxy __WEB_CONTAINER__:__WEB_PORT__
	}
}

import /etc/caddy/routes/*.caddy
