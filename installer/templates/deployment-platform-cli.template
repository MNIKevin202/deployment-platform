#!/usr/bin/env bash
#
# /usr/local/bin/deployment-platform — installed by
# installer/lib/filesystem.sh. Thin wrapper delegating to the real
# installer scripts under /opt/deployment-platform/installer/. Requires
# sudo for anything that touches Docker or the filesystem, matching the
# rest of this platform's maintenance commands (section 8/25).
set -Eeuo pipefail

INSTALL_ROOT="/opt/deployment-platform"
INSTALLER_DIR="${INSTALL_ROOT}/installer"

API_CONTAINER_NAME="deployment-platform-api"
WEB_CONTAINER_NAME="deployment-platform-web"
CADDY_CONTAINER_NAME="deployment-platform-caddy"

usage() {
  cat <<'EOF'
Usage: deployment-platform <command>

  status               Show container status (running/stopped)
  verify               Run local + public verification checks
  installer-status      Show the installer's own state (stage, last run)
  resume-install        Resume an interrupted installation
  show-config            Show non-secret configuration (never secret values)
  logs api|web|caddy     Tail a container's logs
  backup-database         Back up the SQLite database now
  reset-admin-password    Rotate the administrator password (interactive, hidden input)
  uninstall-preview       Show what an uninstall would remove, without changing anything

reset-admin-password:
  Prompts for a new administrator password (hidden, confirmed, minimum 12
  characters), computes the canonical scrypt hash in the same sandboxed
  helper container the installer uses, atomically updates
  ADMIN_PASSWORD_HASH, and recreates the API container so it reads the new
  value. ADMIN_USERNAME, SESSION_SECRET, COOKIE_SECURE and
  CREDENTIAL_ENCRYPTION_KEY are preserved unchanged. The previous secrets
  file is backed up, and any failure rolls back to it automatically.

  Non-interactive use accepts a mode-600 file only — never a password on
  the command line, which would be visible in the process list and shell
  history:

    sudo deployment-platform reset-admin-password --password-file /root/new-password
EOF
}

require_root_for() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "This command requires sudo: sudo deployment-platform $*" >&2
    exit 1
  fi
}

cmd="${1:-}"
shift || true

case "$cmd" in
  status)
    for name in "$API_CONTAINER_NAME" "$WEB_CONTAINER_NAME" "$CADDY_CONTAINER_NAME"; do
      state="$(docker inspect --format '{{.State.Status}}' "$name" 2>/dev/null || echo "not found")"
      printf '%-32s %s\n' "$name" "$state"
    done
    ;;
  verify)
    require_root_for verify
    exec "${INSTALLER_DIR}/install.sh" --verify-only
    ;;
  installer-status)
    if [ -f "${INSTALL_ROOT}/state/installer-state.json" ]; then
      if command -v jq >/dev/null 2>&1; then
        jq '.' "${INSTALL_ROOT}/state/installer-state.json"
      else
        cat "${INSTALL_ROOT}/state/installer-state.json"
      fi
    else
      echo "No installer state found."
    fi
    ;;
  resume-install)
    require_root_for resume-install
    exec "${INSTALLER_DIR}/install.sh" --resume
    ;;
  show-config)
    echo "Panel/apps domain configuration (non-secret):"
    [ -f "${INSTALL_ROOT}/config/platform.env" ] && cat "${INSTALL_ROOT}/config/platform.env"
    echo
    echo "Secret values (auth.env) are never shown by this command."
    ;;
  logs)
    target="${1:-}"
    case "$target" in
      api) exec docker logs -f --tail 200 "$API_CONTAINER_NAME" ;;
      web) exec docker logs -f --tail 200 "$WEB_CONTAINER_NAME" ;;
      caddy) exec docker logs -f --tail 200 "$CADDY_CONTAINER_NAME" ;;
      *) echo "Usage: deployment-platform logs api|web|caddy" >&2; exit 1 ;;
    esac
    ;;
  backup-database)
    require_root_for backup-database
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/common.sh" 2>/dev/null || true
    DRY_RUN=0
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/platform.sh"
    backup_database
    ;;
  reset-admin-password)
    require_root_for reset-admin-password
    password_file_arg=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        (--password-file)
          password_file_arg="${2:-}"
          shift 2
          ;;
        (*)
          echo "Unknown option for reset-admin-password: $1" >&2
          echo "A plaintext password is never accepted as an argument; use --password-file <mode-600-file>." >&2
          exit 1
          ;;
      esac
    done
    # Sourced rather than re-implemented: rotation reuses the installer's
    # own hardened hashing helper and container-creation arguments.
    export DEPLOYMENT_PLATFORM_INSTALLER_ROOT="${INSTALLER_DIR}"
    export INSTALL_ROOT
    export DRY_RUN=0
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/common.sh"
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/prompts.sh"
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/docker.sh"
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/caddy.sh"
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/platform.sh"
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/verify.sh"
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/secrets.sh"
    # shellcheck source=/dev/null
    source "${INSTALLER_DIR}/lib/rollback.sh"
    install_trap_handlers
    rotate_admin_password "${password_file_arg}"
    ;;
  uninstall-preview)
    require_root_for uninstall-preview
    exec "${INSTALLER_DIR}/install.sh" --uninstall-preview
    ;;
  ""|help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
