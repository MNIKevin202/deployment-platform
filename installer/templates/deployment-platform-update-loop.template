#!/usr/bin/env bash
#
# Continuous updater loop. Runs the one-shot deployment-platform-update
# command over and over with a short pause between checks, so every install
# discovers and applies a newly published signed release according to its
# configured channel and update policy — without an operator running an
# update by hand.
#
# Each iteration is cheap when nothing changed: the update command fetches a
# small signed manifest, verifies it, compares versions, and exits early
# unless there is a newer release its policy permits applying. A pull + swap
# only happens when there is genuinely a new release to install (see
# deployment-platform-update and docs/SELF_UPDATE_ARCHITECTURE.md).
#
# The interval is DP_UPDATE_INTERVAL seconds (default 30). A single check is
# never allowed to run concurrently with the next tick: flock holds an
# exclusive lock for the duration of the update, and a slow rebuild simply
# delays the following iteration instead of stacking a second one on top.
set -Eeuo pipefail

INTERVAL="${DP_UPDATE_INTERVAL:-900}"
UPDATE_CMD="${DP_UPDATE_CMD:-/usr/local/bin/deployment-platform-update}"
LOCK_FILE="${DP_UPDATE_LOCK:-/run/lock/deployment-platform-update.lock}"

mkdir -p "$(dirname "$LOCK_FILE")" 2>/dev/null || true

while true; do
  # flock -w bounds how long we wait for a previous run to finish; -E 0 is
  # never reached because we always release before looping, but a stuck lock
  # (e.g. a prior process killed mid-update) is waited on, then retried.
  # `|| true` keeps the loop alive across a failed check — a transient GitHub
  # or Docker hiccup must not stop the service; the next tick retries.
  flock -w "$INTERVAL" "$LOCK_FILE" "$UPDATE_CMD" || true
  sleep "$INTERVAL"
done
