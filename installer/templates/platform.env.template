# Generated by installer/lib/platform.sh. Non-secret configuration
# only — domains and runtime mode. Mode 644 is fine for this file;
# nothing in it is sensitive. Secrets live separately in auth.env
# (mode 600).
PANEL_DOMAIN=__PANEL_DOMAIN__
APPS_DOMAIN=__APPS_DOMAIN__
NODE_ENV=production

# Application routing. The API writes per-app site files into the caddy/routes
# directory (mounted at /app/caddy-routes here, /etc/caddy/routes in Caddy,
# which the main Caddyfile imports) and applies them by restarting the Caddy
# container — no admin API required, so `admin off` stays in effect. Set
# ROUTING_ENABLED=false to turn dynamic routing off.
ROUTING_ENABLED=true
CADDY_ROUTES_DIR=/app/caddy-routes
CADDY_ROUTES_DIR_IN_CADDY=/etc/caddy/routes
CADDY_CONTAINER_NAME=deployment-platform-caddy
CADDY_MAIN_CONFIG_PATH=/etc/caddy/Caddyfile
