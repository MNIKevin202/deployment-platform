#!/usr/bin/env bash
#
# deployment-platform-update — the production self-updater (one tick).
#
# Signed, registry-based, policy-driven. It does NOT clone source and does
# NOT build images. On each invocation it:
#   1. reconciles any interrupted update from the durable state file;
#   2. reads config (channel/policy/window/pending-apply) from the API's DB;
#   3. fetches the configured channel's signed manifest over HTTPS;
#   4. verifies the signature + decides (resolve-update.mjs, sandboxed);
#   5. for an "apply" decision: preflight -> backup -> pull-by-digest ->
#      release-remote.sh (registry mode, migration-aware rollback) -> record.
#
# It runs as a plain host process (one tick per firing of
# deployment-platform-update.timer, via the oneshot deployment-platform-update.service
# and the flock'd deployment-platform-update-tick wrapper) precisely so it
# survives replacing the very containers it updates. The systemd timer owns the
# cadence — there is no internal sleep loop. See docs/SELF_UPDATE_ARCHITECTURE.md.
#
# Flags:
#   (none)        one normal tick (may apply an update per policy)
#   --check-only  run discovery + verify + decide, record status, apply
#                 NOTHING. Safe to run any time, on production, to prove the
#                 whole chain works.
#   --debug       verbose per-stage tracing (config-read, config-parse,
#                 current-version, panel-domain, manifest-url, manifest-fetch,
#                 signature-fetch, trusted-key-lookup, signature-verify+decide,
#                 decision). Combine with --check-only for a safe, fully-traced
#                 production probe. Never logs secrets.
set -Eeuo pipefail

INSTALL_ROOT="${INSTALL_ROOT:-/opt/deployment-platform}"
INSTALLER_STATE_FILE="${INSTALLER_STATE_FILE:-${INSTALL_ROOT}/state/installer-state.json}"
UPDATE_STATE_FILE="${UPDATE_STATE_FILE:-${INSTALL_ROOT}/state/update-state.json}"
LOG_FILE="${LOG_FILE:-${INSTALL_ROOT}/logs/update.log}"
TRUSTED_KEYS_DIR="${TRUSTED_KEYS_DIR:-${INSTALL_ROOT}/config/trusted-keys}"
UPDATER_DIR="${UPDATER_DIR:-${INSTALL_ROOT}/updater}"
RESOLVER="${RESOLVER:-${UPDATER_DIR}/resolve-update.mjs}"
RELEASE_REMOTE="${RELEASE_REMOTE:-${UPDATER_DIR}/release-remote.sh}"
NODE_HELPER_IMAGE="${NODE_HELPER_IMAGE:-node:24-alpine}"

API_CONTAINER="${API_CONTAINER:-deployment-platform-api}"
WEB_CONTAINER="${WEB_CONTAINER:-deployment-platform-web}"
API_IMAGE_REPO="${API_IMAGE_REPO:-deployment-platform-api}"
WEB_IMAGE_REPO="${WEB_IMAGE_REPO:-deployment-platform-web}"
PLATFORM_NETWORK="${PLATFORM_NETWORK:-deployment-platform}"
APPS_NETWORK="${APPS_NETWORK:-deployment-apps}"
API_DATA_VOLUME="${API_DATA_VOLUME:-deployment-platform-api-data}"
DATABASE_PATH_IN_CONTAINER="${DATABASE_PATH_IN_CONTAINER:-/data/deployment-platform.sqlite}"
HISTORY_RETENTION="${DP_UPDATE_HISTORY_RETENTION:-50}"
IMAGE_RETENTION_KEEP="${DP_UPDATE_IMAGE_KEEP:-3}"

CHECK_ONLY=0
DEBUG=0
for _arg in "$@"; do
  case "$_arg" in
    --check-only) CHECK_ONLY=1 ;;
    --debug)      DEBUG=1 ;;
    *) : ;;  # ignore unknown flags (forward-compatible)
  esac
done

# Guarantee the host-side runtime directories this updater writes to (and the
# trusted-keys dir it mounts) exist BEFORE anything uses them. A LEGACY box
# (bootstrapped from an old release.sh install) may never have had them created,
# and the updater must self-heal on EVERY run — legacy, fresh, repaired, service
# restart, or reboot recovery — so state_write() can never fail merely because
# the state dir was never created (the historical line-99 mktemp abort).
# Strictly idempotent: it only creates what is missing and asserts
# least-privilege modes; it NEVER touches directory contents, so an existing
# in-flight update-state file is preserved. Sensitive dirs stay 0700; logs 0750.
# The updater runs as root (systemd), so these creates succeed; each is guarded
# so a genuinely un-writable filesystem surfaces later via the ERR trap with a
# precise message, not a bare early abort.
ensure_runtime_dirs() {
  mkdir -p "${INSTALL_ROOT}/logs"            && chmod 750 "${INSTALL_ROOT}/logs"            || true  # tee target below
  mkdir -p "${INSTALL_ROOT}/state"           && chmod 700 "${INSTALL_ROOT}/state"           || true  # state_write() atomic temp + file
  mkdir -p "${INSTALL_ROOT}/config"          && chmod 700 "${INSTALL_ROOT}/config"          || true
  mkdir -p "${TRUSTED_KEYS_DIR}"             && chmod 700 "${TRUSTED_KEYS_DIR}"             || true  # resolver mounts this read-only
}
ensure_runtime_dirs

exec > >(tee -a "$LOG_FILE") 2>&1
echo "===== $(date -u +%Y-%m-%dT%H:%M:%SZ) deployment-platform update (check-only=${CHECK_ONLY}) ====="

umask 077
TMP="$(mktemp -d /tmp/dp-update.XXXXXX)"
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT

log() { printf '%s\n' "$*"; }

# ---- Diagnostics -------------------------------------------------------------
# A single always-on failure trap so an early abort under `set -Eeuo pipefail`
# can NEVER produce only the header line again: it names the stage reached, the
# failing line, the exit code, and the offending command. --debug additionally
# traces every stage as it is entered. Neither leaks secrets — no command in
# this updater carries a credential on its argv (the only base64 payloads are
# non-secret update-state JSON), and STAGE holds only coarse stage names.
STAGE="startup"
dbg()   { [ "${DEBUG:-0}" -eq 1 ] && log "[debug] $*" || true; }
stage() { STAGE="$1"; dbg "--- stage: $1"; }
on_err() {
  local rc=$?
  log "ERROR: updater aborted (exit ${rc}) at line ${1:-?} during stage '${STAGE}'; last command: ${BASH_COMMAND}"
  return 0
}
trap 'on_err $LINENO' ERR

# ============================================================
# Durable update-state file (atomic writes; the always-alive host process
# owns it, so it is the source of truth for crash recovery). Kept as flat
# key=value lines so it needs no jq to read here — the DB copy (written via
# the API) is what the UI reads as JSON.
# ============================================================

state_write() {
  local state="$1" target="${2:-}" detail="${3:-}"
  local tmp
  tmp="$(mktemp "${INSTALL_ROOT}/state/.update-state.XXXXXX")"
  chmod 600 "$tmp"
  {
    printf 'state=%s\n' "$state"
    printf 'targetVersion=%s\n' "$target"
    printf 'updatedAt=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'detail=%s\n' "$detail"
  } > "$tmp"
  sync "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$UPDATE_STATE_FILE"
  # Best-effort mirror into the DB for the UI (fails silently when the API is
  # mid-swap/down — the host file above is the authority regardless).
  mirror_state_to_db "$state" "$target" "$detail" || true
}

state_read_field() {
  local field="$1"
  [ -f "$UPDATE_STATE_FILE" ] || { printf ''; return 0; }
  grep -oE "^${field}=.*$" "$UPDATE_STATE_FILE" 2>/dev/null | head -n1 | cut -d= -f2- || printf ''
}

# ============================================================
# Platform DB access via docker exec + RAW SQL (node:sqlite), NOT app methods.
#
# The updater must work against a LEGACY API image (e.g. 1.2.6) that predates
# getJsonSetting/the update-history repository. So instead of importing the
# app's compiled DB module, we run small self-contained scripts
# (installer/updater/db-*.mjs) inside the API container — they open the same
# SQLite file the app uses and hit platform_settings (present since migration
# 018) with plain SQL. This is version-independent: it depends only on node
# (present in any node:24-alpine-based image) and the table's shape, never on
# app code. The scripts are piped in on stdin so nothing needs to be mounted
# or copied into the container. Reads happen while the API is up (before any
# swap); writes are best-effort and the host state file remains authoritative.
# ============================================================

db_script() {
  # db_script <script-basename> [docker exec -e flags...] — pipes the given
  # host-side db-*.mjs into `node --input-type=module` in the API container.
  local script="$1"; shift
  docker exec -i "$@" "$API_CONTAINER" node --input-type=module < "${UPDATER_DIR}/${script}"
}

# Prints the combined config JSON: { settings, pending, appliedMax }. Empty on failure.
read_update_config() {
  db_script db-read-config.mjs 2>/dev/null || true
}

current_version() {
  # The running API image's tag == the installed platform version. Guarded with
  # `|| true` so a transient docker hiccup here (pipefail would otherwise make
  # the whole pipeline non-zero) can never abort the tick — the caller treats an
  # empty result as "unknown".
  docker inspect --format '{{.Config.Image}}' "$API_CONTAINER" 2>/dev/null | awk -F: '{print $NF}' || true
}

mirror_state_to_db() {
  local state="$1" target="$2" detail="$3"
  local payload
  payload="$(printf '{"state":"%s","targetVersion":%s,"detail":%s,"updatedAt":"%s"}' \
    "$state" \
    "$([ -n "$target" ] && printf '"%s"' "$target" || printf 'null')" \
    "$([ -n "$detail" ] && printf '"%s"' "$detail" || printf 'null')" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)")"
  DP_KEY="platform_update_state" DP_VALUE_B64="$(printf '%s' "$payload" | base64 | tr -d '\n')" \
    db_script db-write-setting.mjs -e DP_KEY -e DP_VALUE_B64 >/dev/null 2>&1 || return 1
}

clear_pending_apply() {
  # Empty DP_VALUE_B64 deletes the key.
  DP_KEY="platform_update_apply_request" DP_VALUE_B64="" \
    db_script db-write-setting.mjs -e DP_KEY -e DP_VALUE_B64 >/dev/null 2>&1 || true
}

history_start() {
  local from="$1" to="$2" channel="$3" policy="$4" trigger="$5"
  DP_OP="start" DP_FROM="$from" DP_TO="$to" DP_CHANNEL="$channel" DP_POLICY="$policy" DP_TRIGGER="$trigger" \
    db_script db-history.mjs -e DP_OP -e DP_FROM -e DP_TO -e DP_CHANNEL -e DP_POLICY -e DP_TRIGGER \
    2>/dev/null || printf ''
}

history_finish() {
  local id="$1" result="$2" stage="$3" health="$4" rb_attempted="$5" rb_result="$6" diag="$7"
  [ -n "$id" ] || return 0
  DP_OP="finish" DP_ID="$id" DP_RESULT="$result" DP_STAGE="$stage" DP_HEALTH="$health" \
    DP_RB_ATTEMPTED="$rb_attempted" DP_RB_RESULT="$rb_result" DP_DIAG="$diag" DP_KEEP="$HISTORY_RETENTION" \
    db_script db-history.mjs -e DP_OP -e DP_ID -e DP_RESULT -e DP_STAGE -e DP_HEALTH \
      -e DP_RB_ATTEMPTED -e DP_RB_RESULT -e DP_DIAG -e DP_KEEP >/dev/null 2>&1 || true
}

# ============================================================
# JSON field extraction from the resolver's decision (jq if present, else a
# bounded node fallback via the helper image — no jq dependency required).
# ============================================================
json_field() {
  local json="$1" field="$2"
  # Guarded with `|| true`: a jq/node parse error must yield an empty field, not
  # a non-zero pipeline that (under pipefail + set -e) would abort the caller's
  # assignment. Callers already treat empty as "absent / use default".
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$json" | jq -r --arg f "$field" '.[$f] // empty' 2>/dev/null || true
  else
    printf '%s' "$json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const o=JSON.parse(s);const v=o[process.argv[1]];process.stdout.write(v==null?"":String(v));}catch{process.stdout.write("");}})' "$field" 2>/dev/null || true
  fi
}

# ============================================================
# Startup reconciliation: resolve an interrupted update before doing anything.
# ============================================================
reconcile_interrupted_update() {
  local prev
  prev="$(state_read_field state)"
  [ -n "$prev" ] || return 0
  case "$prev" in
    idle|update_available|successful|rolled_back|failed|manual_intervention_required)
      return 0 ;;
    downloading|verifying|preparing)
      # Pre-cutover: the running version was never touched. Safe to abandon.
      log "Reconcile: found interrupted pre-cutover state '${prev}'; abandoning it (old version untouched)."
      state_write idle "" "recovered from interrupted ${prev}"
      return 0 ;;
    installing|migrating|health_checking|rolling_back)
      # Post-cutover: a swap may be half-done. Inspect what is actually
      # running and whether it's healthy, then settle the state honestly.
      log "Reconcile: found interrupted post-cutover state '${prev}'; inspecting running containers."
      if container_running "$API_CONTAINER" && container_running "$WEB_CONTAINER" && api_http_healthy; then
        local running
        running="$(current_version)"
        log "Reconcile: platform is up and healthy at version ${running}."
        state_write idle "" "recovered: healthy at ${running} after interrupted ${prev}"
      else
        log "Reconcile: platform is NOT healthy after an interrupted ${prev}. Flagging manual intervention."
        state_write manual_intervention_required "$(state_read_field targetVersion)" \
          "interrupted during ${prev}; platform not healthy on restart — manual recovery required"
      fi
      return 0 ;;
    *)
      return 0 ;;
  esac
}

container_running() {
  [ "$(docker inspect --format '{{.State.Running}}' "$1" 2>/dev/null || echo false)" = "true" ]
}

api_http_healthy() {
  # The API answers its own /health from inside the container (no public
  # dependency). Bounded, never blocks the loop for long.
  docker exec "$API_CONTAINER" node -e '
const http=require("node:http");
const req=http.request({host:"127.0.0.1",port:Number(process.env.DP_PROBE_PORT||3001),path:"/health",timeout:4000},r=>{process.exit(r.statusCode===200?0:1);});
req.on("timeout",()=>{req.destroy();process.exit(1);});
req.on("error",()=>process.exit(1));
req.end();' >/dev/null 2>&1
}

# ============================================================
# Preflight (fail BEFORE disrupting anything).
# ============================================================
preflight() {
  local api_pull="$1" api_digest="$2" web_pull="$3" web_digest="$4"

  command -v docker >/dev/null 2>&1 || { log "Preflight: docker not found."; return 1; }
  docker info >/dev/null 2>&1 || { log "Preflight: docker daemon not reachable."; return 1; }

  # Disk space: require a comfortable margin on the docker filesystem before
  # pulling two images and taking a backup.
  local avail_kb
  avail_kb="$(df -Pk /var/lib/docker 2>/dev/null | awk 'NR==2{print $4}')"
  if [ -n "$avail_kb" ] && [ "$avail_kb" -lt "${DP_MIN_DISK_KB:-2097152}" ]; then
    log "Preflight: insufficient disk space (${avail_kb}KB available, need >= ${DP_MIN_DISK_KB:-2097152}KB)."
    return 1
  fi

  # Registry connectivity + pullability, by digest. This is the real "can we
  # get the images" check and it happens before any container is touched.
  log "Preflight: pulling ${api_pull}@${api_digest} ..."
  docker pull "${api_pull}@${api_digest}" >/dev/null 2>&1 || { log "Preflight: API image pull failed."; return 1; }
  log "Preflight: pulling ${web_pull}@${web_digest} ..."
  docker pull "${web_pull}@${web_digest}" >/dev/null 2>&1 || { log "Preflight: web image pull failed."; return 1; }

  [ -f "$RELEASE_REMOTE" ] || { log "Preflight: release-remote.sh not found at ${RELEASE_REMOTE}."; return 1; }
  [ -f "${INSTALL_ROOT}/config/auth.env" ] || { log "Preflight: auth.env missing."; return 1; }
  [ -f "${INSTALL_ROOT}/config/platform.env" ] || { log "Preflight: platform.env missing."; return 1; }
  return 0
}

# Verifies the extracted migration payload BEFORE any live container is touched.
# This is the pre-cutover guard for the exact failure that previously only
# surfaced AFTER the swap ("Could not determine expected migrations from
# source"): it proves the migration set is real, parseable by the SAME parser
# release-remote.sh uses during the swap, matches the target image's compiled
# migration list, was extracted completely, and is compatible with this DB's
# applied max. Any failure returns non-zero so the caller aborts before the
# swap. Runs the shipped verify-migrations.mjs INSIDE the target image (which
# carries both the source and the compiled list), sandboxed (no network).
verify_migration_payload() {
  local dir="$1" api_pull="$2" api_digest="$3" applied_max="$4"
  local srcdir="${dir}/apps/api/src/migrations"

  [ -d "$srcdir" ] || { log "Pre-cutover: extracted migrations dir is missing (${srcdir})."; return 1; }
  local host_count
  host_count="$(find "$srcdir" -maxdepth 1 -type f 2>/dev/null | grep -cE '/[0-9]+[^/]*\.ts$' || true)"
  [ -n "$host_count" ] || host_count=0
  if [ "$host_count" -eq 0 ]; then
    log "Pre-cutover: NO migration source files were extracted into ${srcdir} — an empty/failed extraction is NOT 'no migrations'. Aborting before any container is touched."
    return 1
  fi

  # The shipped verifier ships next to this script; mount it read-only into the
  # target image and run it against the image's own source + compiled list. It
  # cross-checks the host-extracted count too (DP_EXPECT_COUNT).
  local verifier="${UPDATER_DIR}/verify-migrations.mjs"
  [ -f "$verifier" ] || { log "Pre-cutover: verify-migrations.mjs not found at ${verifier}."; return 1; }

  local out
  if ! out="$(docker run --rm --network none \
      --security-opt no-new-privileges --cap-drop ALL --read-only --tmpfs /tmp \
      -e DP_APPLIED="$applied_max" -e DP_EXPECT_COUNT="$host_count" \
      --mount "type=bind,src=${verifier},dst=/verify-migrations.mjs,readonly" \
      "${api_pull}@${api_digest}" node /verify-migrations.mjs 2>"$TMP/verify-migrations.err")"; then
    log "Pre-cutover: migration-payload verification FAILED — $(tr -d '\n' < "$TMP/verify-migrations.err" 2>/dev/null)"
    return 1
  fi
  local to_run
  to_run="$(printf '%s' "$out" | grep -oE '"toRun":[0-9]+' | grep -oE '[0-9]+' || echo '?')"
  log "Pre-cutover: migration payload verified (${out}). appliedMax=${applied_max}, migrations to run=${to_run}."
  dbg "verify-migrations stdout: ${out}"
  return 0
}

# Builds the minimal, persistent release directory release-remote.sh needs in
# registry mode: stub package.json + Dockerfiles (existence-only checks) plus
# the target image's real migration source (copied out of the pulled image),
# so the from-source migration-verification step verifies against exactly what
# this release ships — no host source checkout required. HARD-fails (non-zero,
# no silent fallback) if the migration source cannot be extracted or verified,
# so a packaging problem is caught HERE (pre-cutover) rather than after the
# container swap. The destination path (dir) is chosen by the caller so this
# function can log freely without corrupting a captured return value.
prepare_release_dir() {
  local dir="$1" target="$2" source_commit="$3" api_pull="$4" api_digest="$5" applied_max="$6"

  # Create the FULL destination hierarchy — including apps/api/src — BEFORE the
  # docker cp below. docker cp requires the destination's PARENT to exist; the
  # previous code created only apps/api, so the copy of .../src/migrations
  # failed and (worse) was silently turned into an empty dir. Both are fixed.
  mkdir -p "$dir/apps/api/src" "$dir/apps/web" || { log "Pre-cutover: could not create release dir ${dir}."; return 1; }
  printf '{"version":"%s"}\n' "$target" > "$dir/package.json"
  printf '# registry release %s (stub for existence checks)\n' "$target" > "$dir/apps/api/Dockerfile"
  printf '# registry release %s (stub for existence checks)\n' "$target" > "$dir/apps/web/Dockerfile"

  # Extract the migration source out of the target image. A failure here is a
  # HARD pre-cutover failure — the migration set the swap must verify could not
  # be obtained, so we must NOT proceed into the container swap. NO silent
  # empty-dir fallback (that is what let a packaging failure reach post-cutover).
  local cid
  if ! cid="$(docker create "${api_pull}@${api_digest}")"; then
    log "Pre-cutover: 'docker create' of the target image failed; cannot extract migration source."
    return 1
  fi
  if ! docker cp "${cid}:/app/apps/api/src/migrations" "$dir/apps/api/src/migrations" >/dev/null 2>&1; then
    docker rm "$cid" >/dev/null 2>&1 || true
    log "Pre-cutover: FAILED to extract migration source (/app/apps/api/src/migrations) from the target image. This is a hard failure — refusing to continue. No containers were touched."
    return 1
  fi
  docker rm "$cid" >/dev/null 2>&1 || true

  # Prove the extracted payload before returning success.
  verify_migration_payload "$dir" "$api_pull" "$api_digest" "$applied_max" || return 1
  return 0
}

# Rollback safety: are all migrations newer than the currently-applied max
# classified "expand"? Computed from the TARGET image's own compiled list, so
# it reflects exactly what this update will run. Prints 1 (safe) or 0.
compute_rollback_safe() {
  local api_pull="$1" api_digest="$2" applied_max="$3"
  docker run --rm --network none -e DP_APPLIED="$applied_max" "${api_pull}@${api_digest}" \
    node --input-type=module -e '
import { computeRollbackSafety } from "/app/apps/api/dist/migrations/index.js";
process.stdout.write(computeRollbackSafety(Number(process.env.DP_APPLIED || "0")) ? "1" : "0");
' 2>/dev/null || printf '0'
}

# Retention: keep only the newest few local image tags per platform repo, so
# accumulated pulled images don't fill the disk. Never force-removes: an
# in-use tag (the live container's, and its preserved rollback) is refused by
# docker and simply kept. Semver-sorted, newest kept.
cleanup_old_images() {
  local repo keep="$IMAGE_RETENTION_KEEP"
  for repo in "$API_IMAGE_REPO" "$WEB_IMAGE_REPO"; do
    local tags
    tags="$(docker images --format '{{.Tag}}' "$repo" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V -r || true)"
    local i=0 tag
    while IFS= read -r tag; do
      [ -n "$tag" ] || continue
      i=$((i + 1))
      if [ "$i" -gt "$keep" ]; then
        docker rmi "${repo}:${tag}" >/dev/null 2>&1 || true
      fi
    done <<< "$tags"
  done
}

# ============================================================
# Main
# ============================================================

reconcile_interrupted_update

# A prior tick that ended in manual_intervention_required must NOT silently
# start another update. It stays put until an operator clears it (which the
# API does by resetting state / issuing a manual apply).
if [ "$(state_read_field state)" = "manual_intervention_required" ] && [ "$CHECK_ONLY" -eq 0 ]; then
  log "State is manual_intervention_required — refusing to start a new update until an operator clears it."
  exit 0
fi

if ! container_running "$API_CONTAINER"; then
  log "API container is not running; cannot read config or check for updates this tick."
  exit 0
fi

# In --check-only, a failure to COMPLETE the discover/verify/decide chain is a
# hard error (non-zero exit) so the bootstrap can detect it and NOT print a
# false PASS. In normal (looped) mode the same condition is a soft skip (exit
# 0) — a transient network blip must never crash the service.
end_incomplete() {  # <state> <detail> [exit-code]
  local st="$1" detail="$2" code="${3:-3}"
  state_write "$st" "" "$detail"
  if [ "$CHECK_ONLY" -eq 1 ]; then
    log "check-only FAILED: ${detail}"
    exit "$code"
  fi
  log "skipping this tick: ${detail}"
  exit 0
}

stage config-read
CONFIG_JSON="$(read_update_config)"
[ -n "$CONFIG_JSON" ] || end_incomplete idle "could not read update config from the platform database" 3
dbg "config JSON read from DB ($(printf '%s' "$CONFIG_JSON" | wc -c | tr -d ' ') bytes)"

stage config-parse
SETTINGS_JSON="$(json_field "$CONFIG_JSON" settings)"
CHANNEL="$(json_field "$SETTINGS_JSON" channel)"; [ -n "$CHANNEL" ] || CHANNEL="stable"
POLICY="$(json_field "$SETTINGS_JSON" policy)"; [ -n "$POLICY" ] || POLICY="notify_only"
MANIFEST_BASE="$(json_field "$SETTINGS_JSON" manifestBaseUrl)"
[ -n "$MANIFEST_BASE" ] || end_incomplete idle "no manifestBaseUrl configured (run the bootstrap to seed update settings)" 3
MAINT_WINDOW="$(json_field "$SETTINGS_JSON" maintenanceWindow)"
PENDING="$(json_field "$CONFIG_JSON" pending)"
APPLIED_MAX="$(json_field "$CONFIG_JSON" appliedMax)"; [ -n "$APPLIED_MAX" ] || APPLIED_MAX=0
dbg "parsed config: channel=${CHANNEL} policy=${POLICY} appliedMax=${APPLIED_MAX} manifestBase=${MANIFEST_BASE}"

stage current-version
CURRENT="$(current_version)"
dbg "current running version: ${CURRENT:-unknown}"

# Panel domain is only needed to build --url-panel for an actual APPLY. It lives
# in the NEW installer's state file, which a LEGACY box (set up by the old
# release.sh) simply does not have. A missing file or missing key here is normal
# and must never abort the tick: unguarded, grep exits 2 on a missing file (or 1
# on no match) and — under `set -o pipefail` + `set -e` — that killed the whole
# updater right after the header with a bare exit 2 (the legacy check-only bug
# this fixes). Guard the file test and the pipeline; absent -> empty is fine.
stage panel-domain
PANEL_DOMAIN=""
if [ -f "$INSTALLER_STATE_FILE" ]; then
  PANEL_DOMAIN="$(grep -oE '"panelDomain"[[:space:]]*:[[:space:]]*"[^"]*"' "$INSTALLER_STATE_FILE" 2>/dev/null | sed -E 's/.*"([^"]*)"$/\1/' | head -n1 || true)"
  dbg "panel domain from state file: ${PANEL_DOMAIN:-<none found>}"
else
  dbg "installer state file absent (${INSTALLER_STATE_FILE}) — legacy box; panel domain unknown (only needed for APPLY)"
fi

stage manifest-url
MANIFEST_URL="${MANIFEST_BASE%/}/${CHANNEL}-latest/manifest.json"
SIGNATURE_URL="${MANIFEST_BASE%/}/${CHANNEL}-latest/manifest.json.sig"
dbg "manifest URL:  ${MANIFEST_URL}"
dbg "signature URL: ${SIGNATURE_URL}"

state_write checking "" "checking ${CHANNEL} channel"

# --- fetch (HTTPS only; curl on the host, no secrets) ---
case "$MANIFEST_URL" in https://*) ;; *) end_incomplete failed "refusing non-HTTPS manifest URL" 4 ;; esac
stage manifest-fetch
if ! curl -fsSL --max-time 30 "$MANIFEST_URL" -o "$TMP/manifest.json"; then
  end_incomplete idle "could not fetch the release manifest (${MANIFEST_URL} unavailable?)" 4
fi
stage signature-fetch
if ! curl -fsSL --max-time 30 "$SIGNATURE_URL" -o "$TMP/manifest.json.sig"; then
  end_incomplete idle "could not fetch the release signature (${SIGNATURE_URL} unavailable?)" 4
fi
dbg "fetched manifest ($(wc -c < "$TMP/manifest.json" 2>/dev/null | tr -d ' ' || echo '?') bytes) + signature ($(wc -c < "$TMP/manifest.json.sig" 2>/dev/null | tr -d ' ' || echo '?') bytes)"

stage trusted-key-lookup
dbg "trusted keys available: $(find "$TRUSTED_KEYS_DIR" -maxdepth 1 -name '*.pem' 2>/dev/null | wc -l | tr -d ' ' || echo 0) in ${TRUSTED_KEYS_DIR}"

# --- verify + decide (sandboxed; no network, keys+files mounted read-only) ---
cat > "$TMP/context.json" <<EOF
{
  "currentVersion": $( [ -n "$CURRENT" ] && printf '"%s"' "$CURRENT" || printf 'null' ),
  "channel": "$CHANNEL",
  "policy": "$POLICY",
  "maintenanceWindow": ${MAINT_WINDOW:-null},
  "appliedMaxMigrationVersion": ${APPLIED_MAX:-0},
  "manifestPath": "/work/manifest.json",
  "signaturePath": "/work/manifest.json.sig",
  "trustedKeysDir": "/work/keys",
  "pendingApply": ${PENDING:-null}
}
EOF

stage signature-verify+decide
DECISION="$(docker run --rm --network none \
  --user "$(id -u):$(id -g)" --security-opt no-new-privileges --cap-drop ALL --read-only --tmpfs /tmp \
  --mount "type=bind,src=${RESOLVER},dst=/work/resolve-update.mjs,readonly" \
  --mount "type=bind,src=${TMP}/manifest.json,dst=/work/manifest.json,readonly" \
  --mount "type=bind,src=${TMP}/manifest.json.sig,dst=/work/manifest.json.sig,readonly" \
  --mount "type=bind,src=${TMP}/context.json,dst=/work/context.json,readonly" \
  --mount "type=bind,src=${TRUSTED_KEYS_DIR},dst=/work/keys,readonly" \
  "$NODE_HELPER_IMAGE" node /work/resolve-update.mjs /work/context.json 2>/dev/null || true)"

[ -n "$DECISION" ] || end_incomplete idle "resolver produced no decision (helper failed to run — is ${NODE_HELPER_IMAGE} pullable?)" 5
stage decision
log "Decision: ${DECISION}"

ACTION="$(json_field "$DECISION" action)"
REASON="$(json_field "$DECISION" reason)"
TARGET="$(json_field "$DECISION" targetVersion)"

# Did the chain actually verify the signature and reach a trustworthy decision?
# "apply"/"notify" are only reachable AFTER signature verification passes; a
# "none" is trustworthy ONLY when it is "up-to-date" (also post-verification).
# Every other "none" reason (manifest-unreadable, signature-verification-failed,
# unknown-signing-key, invalid-*, channel-mismatch, current-version-not-semver)
# means the chain did NOT complete a verified decision.
CHAIN_VERIFIED=0
case "$ACTION" in
  notify|apply) CHAIN_VERIFIED=1 ;;
  none) [ "$REASON" = "up-to-date" ] && CHAIN_VERIFIED=1 ;;
esac

if [ "$CHECK_ONLY" -eq 1 ]; then
  if [ "$CHAIN_VERIFIED" -eq 1 ]; then
    state_write "$([ "$ACTION" = "none" ] && echo idle || echo update_available)" "$TARGET" "check-only OK: ${ACTION} (${REASON})"
    log "check-only PASSED: signature verified, decision=${ACTION} reason=${REASON} target=${TARGET:-none}."
    printf 'CHECK_RESULT=verified action=%s reason=%s target=%s\n' "$ACTION" "$REASON" "${TARGET:-none}"
    exit 0
  fi
  end_incomplete failed "decision not verified (action=${ACTION}, reason=${REASON})" 5
fi

# --- normal (looped) mode ---
case "$ACTION" in
  none)
    state_write idle "" "${REASON}"
    exit 0 ;;
  notify)
    state_write update_available "$TARGET" "${REASON}"
    log "Update available: ${TARGET} (${REASON}). Not applying automatically."
    exit 0 ;;
  apply)
    : ;; # fall through to APPLY
  *)
    state_write idle "" "unknown action ${ACTION}"
    exit 0 ;;
esac

# ============================================================
# APPLY
# ============================================================
TRIGGER="$(json_field "$DECISION" trigger)"; [ -n "$TRIGGER" ] || TRIGGER="automatic"
API_PULL="$(json_field "$DECISION" apiRepository)"
API_DIGEST="$(json_field "$DECISION" apiDigest)"
WEB_PULL="$(json_field "$DECISION" webRepository)"
WEB_DIGEST="$(json_field "$DECISION" webDigest)"
SOURCE_COMMIT="$(json_field "$DECISION" sourceCommit)"

HISTORY_ID="$(history_start "$CURRENT" "$TARGET" "$CHANNEL" "$POLICY" "$TRIGGER")"

state_write downloading "$TARGET" "preflight + pull"
if ! preflight "$API_PULL" "$API_DIGEST" "$WEB_PULL" "$WEB_DIGEST"; then
  state_write failed "$TARGET" "preflight failed"
  history_finish "$HISTORY_ID" "failed" "preflight" "" 0 "" "preflight checks failed (see update.log)"
  exit 1
fi

state_write verifying "$TARGET" "computing rollback safety"
ROLLBACK_SAFE="$(compute_rollback_safe "$API_PULL" "$API_DIGEST" "$APPLIED_MAX")"
log "Rollback safety for this update: ${ROLLBACK_SAFE} (1=safe container swap-back, 0=breaking migration -> DB restore path)."

state_write preparing "$TARGET" "preparing + verifying migration payload (pre-cutover)"
# Choose the release dir path HERE so prepare_release_dir can log freely (its
# stdout is not captured). prepare_release_dir extracts AND verifies the
# migration payload; if it fails, this is a HARD pre-cutover failure — the old
# containers are never renamed and no replacement containers are started (the
# swap, below, is never reached). We no longer depend on post-cutover rollback
# for a packaging problem that is detectable now.
RELEASE_DIR="${INSTALL_ROOT}/source/releases/release-$(date -u +%Y%m%dT%H%M%SZ)-${SOURCE_COMMIT:0:12}"
if ! prepare_release_dir "$RELEASE_DIR" "$TARGET" "$SOURCE_COMMIT" "$API_PULL" "$API_DIGEST" "$APPLIED_MAX"; then
  state_write failed "$TARGET" "pre-cutover: migration payload extraction/verification failed (no containers touched)"
  history_finish "$HISTORY_ID" "failed" "prepare" "" 0 "" "migration source could not be extracted/verified before cutover"
  exit 1
fi
[ -d "$RELEASE_DIR" ] || {
  state_write failed "$TARGET" "release dir missing after prepare"
  history_finish "$HISTORY_ID" "failed" "prepare" "" 0 "" "release dir missing after prepare"
  exit 1
}

PREV_API_VERSION="$(current_version)"; [ -n "$PREV_API_VERSION" ] || PREV_API_VERSION="unknown"
PREV_WEB_VERSION="$(docker inspect --format '{{.Config.Image}}' "$WEB_CONTAINER" 2>/dev/null | awk -F: '{print $NF}')"
[ -n "$PREV_WEB_VERSION" ] || PREV_WEB_VERSION="unknown"

state_write installing "$TARGET" "swapping containers"
# release-remote.sh takes the pre-update DB backup (VACUUM INTO), does the
# three-phase swap, runs migrations (in-container, at start), verifies image/
# network/migrations/health, and — with --rollback-safe passed — chooses the
# correct rollback strategy on failure. We reuse it wholesale.
set +e
RELEASE_OUTPUT="$(bash "$RELEASE_REMOTE" \
  --mode both --image-source registry \
  --source-dir "$RELEASE_DIR" \
  --auth-file "${INSTALL_ROOT}/config/auth.env" \
  --platform-env-file "${INSTALL_ROOT}/config/platform.env" \
  --caddy-routes-dir "${INSTALL_ROOT}/caddy/routes" \
  --api-container "$API_CONTAINER" --web-container "$WEB_CONTAINER" \
  --api-image-repo "$API_IMAGE_REPO" --web-image-repo "$WEB_IMAGE_REPO" \
  --api-pull-repository "$API_PULL" --web-pull-repository "$WEB_PULL" \
  --api-image-digest "$API_DIGEST" --web-image-digest "$WEB_DIGEST" \
  --platform-network "$PLATFORM_NETWORK" --apps-network "$APPS_NETWORK" \
  --api-data-volume "$API_DATA_VOLUME" \
  --api-version "$TARGET" --web-version "$TARGET" \
  --source-commit "$SOURCE_COMMIT" \
  --previous-api-version "$PREV_API_VERSION" --previous-web-version "$PREV_WEB_VERSION" \
  --url-panel "https://${PANEL_DOMAIN}" \
  --current-symlink "${INSTALL_ROOT}/source/current" \
  --rollback-safe "$ROLLBACK_SAFE" 2>&1)"
RELEASE_RC=$?
set -e
printf '%s\n' "$RELEASE_OUTPUT"

STATUS="$(printf '%s\n' "$RELEASE_OUTPUT" | grep -oE '^RELEASE_SUMMARY_STATUS=.*$' | tail -n1 | cut -d= -f2- || true)"
[ -n "$STATUS" ] || STATUS="UNKNOWN"

# The ACTUAL failure reason release-remote reported (empty on success). Recorded
# verbatim in history/detail instead of guessing — the failed v1.3.1 attempt was
# a migration-verification failure but history hardcoded "health_check".
FAIL_REASON="$(printf '%s\n' "$RELEASE_OUTPUT" | grep -oE '^RELEASE_SUMMARY_FAIL_REASON=.*$' | tail -n1 | cut -d= -f2- || true)"

# Derive a coarse failure stage from that reason (best-effort classification;
# the full reason is always preserved as the detail). This is deliberately just
# a label for the history's failure_stage column.
failure_stage_from_reason() {
  local r="$1"
  case "$r" in
    *migration*|*schema*)                 printf 'migration_verify' ;;
    *health*|*HTTP*|*unhealthy*)          printf 'health_check' ;;
    *image*|*digest*|*pull*)              printf 'image_verify' ;;
    *network*)                            printf 'network_verify' ;;
    *backup*)                             printf 'backup' ;;
    *[Cc]addy*|*route*|*proxy*)           printf 'caddy' ;;
    *migrate*)                            printf 'migrate' ;;
    "")                                   printf 'release' ;;
    *)                                    printf 'release' ;;
  esac
}
FAIL_STAGE="$(failure_stage_from_reason "$FAIL_REASON")"
[ -n "$FAIL_REASON" ] || FAIL_REASON="see ${LOG_FILE}"

clear_pending_apply

case "$STATUS" in
  PASS|PASS_WITH_WARNINGS)
    state_write health_checking "$TARGET" "verifying running version"
    RUNNING="$(current_version)"
    if [ "$RUNNING" = "$TARGET" ] && api_http_healthy; then
      state_write successful "$TARGET" "updated and healthy at ${TARGET}"
      history_finish "$HISTORY_ID" "successful" "" "passed" 0 "" "updated to ${TARGET} (${STATUS})"
      cleanup_old_images
      state_write idle "$TARGET" "idle after successful update to ${TARGET}"
      log "Update to ${TARGET} succeeded."
    else
      state_write manual_intervention_required "$TARGET" "post-deploy verification mismatch (running=${RUNNING})"
      history_finish "$HISTORY_ID" "manual_intervention_required" "post-verify" "failed" 0 "" "running=${RUNNING} expected=${TARGET}"
    fi
    ;;
  ROLLED_BACK)
    state_write rolled_back "$TARGET" "rolled back to previous version (${FAIL_STAGE}): ${FAIL_REASON}"
    history_finish "$HISTORY_ID" "rolled_back" "$FAIL_STAGE" "failed" 1 "rolled_back" "auto-rolled back to ${PREV_API_VERSION}; failure: ${FAIL_REASON}"
    ;;
  MANUAL_INTERVENTION_REQUIRED)
    state_write manual_intervention_required "$TARGET" "DB restore required (${FAIL_STAGE}): ${FAIL_REASON}"
    history_finish "$HISTORY_ID" "manual_intervention_required" "$FAIL_STAGE" "failed" 1 "unsafe-not-attempted" "breaking migration ran; automatic rollback unsafe; failure: ${FAIL_REASON}"
    ;;
  ROLLBACK_FAILED)
    state_write manual_intervention_required "$TARGET" "rollback itself failed — active incident (${FAIL_STAGE}): ${FAIL_REASON}"
    history_finish "$HISTORY_ID" "manual_intervention_required" "rollback" "failed" 1 "rollback_failed" "rollback did not fully succeed after failure: ${FAIL_REASON}"
    ;;
  FAILED|*)
    # Failed before any cutover: the previous version is untouched.
    state_write failed "$TARGET" "update failed before cutover (rc=${RELEASE_RC}, status=${STATUS})"
    history_finish "$HISTORY_ID" "failed" "pre-cutover" "" 0 "" "status=${STATUS} rc=${RELEASE_RC}"
    ;;
esac

exit 0
