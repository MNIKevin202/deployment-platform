[Unit]
Description=Deployment Platform signed-release self-updater (one tick)
Documentation=https://github.com/MNIKevin202/deployment-platform
# Only meaningful once Docker and the network are up — a tick that cannot reach
# GitHub or the Docker socket just fails and the timer retries later. Ordering
# after these avoids a guaranteed-failing tick right at boot.
After=network-online.target docker.service
Wants=network-online.target

[Service]
# ONE updater tick, then exit — cadence is owned by
# deployment-platform-update.timer (Option A). There is deliberately no internal
# sleep loop and the unit does not auto-restart: the timer, not this unit,
# decides when the next tick runs. The tick wrapper takes an exclusive flock so a
# slow apply can never overlap the next firing (it skips cleanly if one is still
# running).
Type=oneshot
ExecStart=/usr/local/bin/deployment-platform-update-tick

# No [Install] section on purpose: this service is a template invoked by
# deployment-platform-update.timer (Unit=…update.service). It must NOT be
# enabled or started on its own — enabling the TIMER is what schedules updates.
