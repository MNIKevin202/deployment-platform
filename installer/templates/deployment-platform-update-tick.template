#!/usr/bin/env bash
#
# deployment-platform-update-tick — ONE lock-protected updater tick, invoked by
# deployment-platform-update.timer's oneshot service.
#
# Scheduling model (Option A): the systemd TIMER owns the cadence. There is NO
# internal sleep loop here — this runs a single update tick and exits, so the
# only long-running process is the timer, and inspection is trivial
# (`systemctl list-timers`). flock (-n) guarantees non-overlap: if a previous
# tick is still running (e.g. a slow rebuild), this firing is skipped cleanly
# rather than stacking a second concurrent update.
#
# Manual foreground use is unchanged and does NOT go through this wrapper — run
# the update command directly:
#   deployment-platform-update            # one normal tick (may apply per policy)
#   deployment-platform-update --check-only --debug   # safe, applies nothing
set -Eeuo pipefail

UPDATE_CMD="${DP_UPDATE_CMD:-/usr/local/bin/deployment-platform-update}"
LOCK_FILE="${DP_UPDATE_LOCK:-/run/lock/deployment-platform-update.lock}"

mkdir -p "$(dirname "$LOCK_FILE")" 2>/dev/null || true

# -n: never block; -E 75: if the lock is held, exit with 75 (a sentinel that is
# distinct from any exit code the update command itself uses), so a genuine
# update failure is never confused with "another tick is already running".
flock -n -E 75 "$LOCK_FILE" "$UPDATE_CMD" "$@"
rc=$?
if [ "$rc" -eq 75 ]; then
  echo "deployment-platform-update-tick: a previous tick is still running; skipping this firing."
  exit 0
fi
exit "$rc"
