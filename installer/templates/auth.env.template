# Generated by installer/lib/secrets.sh. Mode 600 — never world- or
# group-readable. Never committed, never copied into a source release,
# never printed by the installer or any `deployment-platform` command.
#
# CREDENTIAL_ENCRYPTION_KEY is never silently regenerated once set: a
# lost or rotated key would make every already-stored provider
# credential unreadable.
ADMIN_USERNAME=__ADMIN_USERNAME__
ADMIN_PASSWORD_HASH=__ADMIN_PASSWORD_HASH__
ENVIRONMENT_EXPORT_PASSWORD_HASH=__ENVIRONMENT_EXPORT_PASSWORD_HASH__
SESSION_SECRET=__SESSION_SECRET__
COOKIE_SECURE=true
CREDENTIAL_ENCRYPTION_KEY=__CREDENTIAL_ENCRYPTION_KEY__

# Optional GitHub App integration — NOT generated by the installer. Add
# ONE of these by hand after registering a GitHub App (see
# installer/README.md's "GitHub App integration" section); the
# non-secret GITHUB_APP_ID/GITHUB_APP_SLUG/GITHUB_APP_CALLBACK_URL
# belong in platform.env instead.
# GITHUB_APP_PRIVATE_KEY_PATH=/opt/deployment-platform/config/github-app-key.pem
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
