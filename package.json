{
  "name": "deployment-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@deployment-platform/api",
    "dev:api": "npm run dev --workspace=@deployment-platform/api",
    "dev:web": "npm run dev --workspace=@deployment-platform/web",
    "build": "npm run build --workspaces --if-present"
  }
}
